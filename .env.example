# ============ 数据库 ============
# 应用实例的 Prisma 连接池默认为 10 个连接，取连接最长等待 10 秒。
# PostgreSQL 连接串。本地开发示例：
#   postgresql://pruser:prpass123@localhost:5432/prdb?schema=public
# Docker Compose 部署时由 compose 文件自动注入，可不填。
DATABASE_URL="postgresql://pruser:prpass123@localhost:5432/prdb?schema=public"

# ============ NextAuth ============
# 会话加密密钥，生产环境务必换成随机长字符串。
# 生成方法：openssl rand -base64 32
NEXTAUTH_SECRET="请替换为随机字符串"
# 应用对外访问地址（影响登录回调）。本地开发用 http://localhost:3000，
# 阿里云部署时改为 http://服务器公网IP:3000 或你的域名。
NEXTAUTH_URL="http://localhost:3000"

# ============ Docker Compose 专用 ============
# 数据库密码（compose 会用它初始化 postgres 并拼出 DATABASE_URL）
DB_PASSWORD="prpass123"
# 应用端口映射（宿主机端口）
APP_PORT="3000"

# ============ 飞书通知（可选） ============
# 在 https://open.feishu.cn/app 创建应用，申请"获取用户 user_id"与"发送消息"权限后填入。
# 未配置时为 mock 模式：通知只写 NotificationLog 记录，不真实发送。
# 用户的飞书 user_id 在「用户管理」中填写（feishuUserId 字段）。
FEISHU_APP_ID=""
FEISHU_APP_SECRET=""
